{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "static/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__p=/$1" }
  ]
}
